# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# user data (should not be tracked)
data/
data/results.json
data/tmp/
data/videos/
data/audio/
data/avatar/
data/youtube-token.json

# Google OAuth credentials
client_secret*.json
token.json

# Media files
*.mp4
*.mp3
*.aiff
*.wav
*.mkv
*.webm

# node_modules
node_modules/

# Claude worktrees
.claude/
